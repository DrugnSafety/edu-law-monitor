# 필수: 열린국회정보 Open API 인증키 (https://open.assembly.go.kr)
ASSEMBLY_API_KEY=

# 선택: 있으면 Postgres 사용(테이블 자동 생성), 없으면 ./data/store.json
DATABASE_URL=

# 관리자/크론 보호
ADMIN_TOKEN=
CRON_SECRET=
# IP 해시 솔트(미설정 시 ADMIN_TOKEN 또는 기본값 사용)
IP_HASH_SALT=

# 사이트 절대 URL(이메일 링크용)
SITE_URL=http://localhost:3210

# 선택: 네이버 검색 API (뉴스·블로그·카페)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택: Anthropic API (요약·전망). 없으면 규칙 기반 문구
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# 선택: Resend (이메일). 없으면 콘솔/outbox 기록
RESEND_API_KEY=
EMAIL_FROM="교원 육아휴직 입법 모니터 <noreply@example.com>"
